# Normaliza quebras de linha entre Windows, Mac e Linux.
# Sem isso, um arquivo salvo no Windows aparece como "totalmente alterado"
# para quem usa Mac — e o PR fica ilegível.
* text=auto eol=lf

# Binários: nunca converter.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
*.xlsx binary
